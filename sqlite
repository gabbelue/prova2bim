@app.route('/usuarios')
def listar_usuarios():
if 'username' not in session:
return redirect(url_for('login'))
conn = conectar_banco()
cursor = conn.cursor()
cursor.execute('SELECT nome, username FROM usuarios')
usuarios = cursor.fetchall()
conn.close()
return render_template('usuarios.html', usuarios=usuarios)
